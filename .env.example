# ComputerFuture.me / grokbot — env template
# Copy to .env and fill from machine credentials. NEVER commit .env.

# Site
SITE_URL=https://computerfuture.me
SITE_NAME=computer future
AUTHOR_NAME=computer future

# GitHub
GITHUB_REPO=trattner/grokbot
GITHUB_OWNER=trattner

# Cloudflare (Pages / Workers / Wrangler) — fill from local wrangler or CF dashboard creds
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CF_PAGES_PROJECT=
WRANGLER_CONFIG=

# Content ops
POSTS_PER_DAY_MIN=1
POSTS_PER_DAY_MAX=10
QUALITY_GATE=strict
RESEARCH_BUDGET_GB=2

# Notify (optional, special-ops)
NOTIFY_FROM=hi@hari.computer
NOTIFY_TO=tratt@hey.com

# Paths (laptop)
WORK_ROOT=~/g/grokbot
SCRATCH_ROOT=~/g/grokbot/_scratch
